<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.portfolio.ticket.mapper.PerformanceMapper">

    <!--
        회차(performance_schedule) 한 행에 거는 조건들 — 월 · 요일 · 시간대.

        셋을 한 덩어리로 묶는 게 핵심이다. 따로 걸면 "8월 + 주말" 이 <i>8월에 회차가 있고,
        (아무 달이든) 주말 회차도 있는</i> 공연을 뜻하게 되어, 9월 주말 공연이 8월에도
        회차가 있다는 이유로 걸린다. 같은 ps 행에 걸어야 "8월의 주말 회차" 가 된다.

        MONTH()/DAYOFWEEK() 는 컬럼을 감싸므로 idx_schedule_showat 를 타지 못한다.
        회차 수가 공연당 8건 수준이라 지금 규모에서는 문제되지 않지만, 회차가 크게 늘면
        show_at 에서 뽑은 월/요일 컬럼을 따로 두는 걸 고려할 것.

        DAYOFWEEK 는 1=일 … 7=토. H2(MODE=MySQL)와 MariaDB 가 번호 체계까지 같은 걸
        확인하고 골랐다 — EXTRACT(ISO_DAY_OF_WEEK) 는 1=월이라 값이 달라진다.
    -->
    <sql id="scheduleConditions">
        <if test="f.month != null">AND MONTH(ps.show_at) = #{f.month}</if>
        <if test="f.daysOfWeek != null and f.daysOfWeek.size() &gt; 0">
            AND DAYOFWEEK(ps.show_at) IN
            <foreach item="d" collection="f.daysOfWeek" open="(" separator="," close=")">#{d}</foreach>
        </if>
        <if test="f.timeSlotFrom != null and f.timeSlotTo != null">
            AND CAST(ps.show_at AS TIME) &gt;= #{f.timeSlotFrom}
            AND CAST(ps.show_at AS TIME) &lt;  #{f.timeSlotTo}
        </if>
    </sql>

    <!-- 회차와 무관한 필터. selectMonthCounts 는 회차를 JOIN 해서 세므로 이 조각만 따로 쓴다. -->
    <sql id="nonScheduleFilters">
        <if test="f.status == 'ONGOING'">AND p.end_date &gt;= #{f.today}</if>
        <if test="f.status == 'ENDED'">AND p.end_date &lt; #{f.today}</if>
        <if test="f.keyword != null and f.keyword != ''">
            AND p.title LIKE CONCAT('%', #{f.keyword}, '%')
        </if>
        <if test="f.region != null and f.region != ''">
            AND p.region = #{f.region}
        </if>
    </sql>

    <!--
        category/venue 를 제외한 공통 필터. selectPerformances/countPerformances 는
        여기에 category/venue 조건을 추가하고, select*Counts 는 자기 자신의 축(facet)만
        빼고 나머지를 추가한다. (월은 회차 조건이라 여기 EXISTS 안으로 들어갔다 —
        예전처럼 각 select 마다 따로 붙이지 않는다.)
    -->
    <sql id="commonFilters">
        <include refid="nonScheduleFilters"/>
        <if test="f.month != null
                  or (f.daysOfWeek != null and f.daysOfWeek.size() &gt; 0)
                  or (f.timeSlotFrom != null and f.timeSlotTo != null)">
            AND EXISTS (
                SELECT 1 FROM performance_schedule ps
                 WHERE ps.performance_id = p.id
                <include refid="scheduleConditions"/>
            )
        </if>
    </sql>

    <!--
        정렬. 값은 반드시 <choose> 로 비교해서 고른다 — ${f.sort} 로 ORDER BY 에 이어붙이면
        쿼리 파라미터가 그대로 SQL 이 되어 주입이 뚫린다(#{} 는 ORDER BY 에 못 쓴다).
        여기 없는 값은 서비스가 이미 기본 정렬로 바꿔서 넘긴다.

        어느 갈래든 마지막에 p.id 를 붙이는 게 중요하다. 정렬 키가 같은 행들의 순서가
        쿼리마다 달라지면 LIMIT/OFFSET 페이징이 흔들려서, 같은 공연이 2페이지에 또 나오거나
        아예 안 나온다. 종전 기본 정렬(start_date 만)에 실제로 있던 문제다 —
        수집 데이터는 개막일이 겹치는 공연이 흔하다.

        NULL 은 CASE 로 직접 뒤로 보낸다. NULLS LAST 는 H2 와 MariaDB 의 기본 동작이
        서로 달라서(MariaDB 는 ASC 에서 NULL 이 앞) 그대로 두면 DB 마다 순서가 갈린다.
    -->
    <sql id="orderBy">
        <choose>
            <when test="f.sort == 'closing'">
                ORDER BY (CASE WHEN p.end_date IS NULL THEN 1 ELSE 0 END) ASC,
                         p.end_date ASC, p.id ASC
            </when>
            <when test="f.sort == 'newest'">
                ORDER BY p.id DESC
            </when>
            <when test="f.sort == 'priceAsc'">
                ORDER BY (CASE WHEN p.base_price IS NULL THEN 1 ELSE 0 END) ASC,
                         p.base_price ASC, p.id ASC
            </when>
            <otherwise>
                ORDER BY (CASE WHEN p.poster_url IS NOT NULL AND p.poster_url &lt;&gt; '' THEN 0 ELSE 1 END) ASC,
                         p.start_date ASC, p.id ASC
            </otherwise>
        </choose>
    </sql>

    <select id="selectPerformances" resultType="com.portfolio.ticket.mapper.dto.PerformanceListRow">
        SELECT p.id          AS id,
               p.title        AS title,
               p.venue        AS venue,
               p.poster_url   AS poster_url,
               p.category     AS category,
               p.start_date   AS start_date,
               p.end_date     AS end_date
          FROM performance p
         WHERE 1 = 1
        <include refid="commonFilters"/>
        <if test="f.category != null and f.category != ''">AND p.category = #{f.category}</if>
        <if test="f.venue != null and f.venue != ''">AND p.venue = #{f.venue}</if>
        <include refid="orderBy"/>
         LIMIT #{f.limit} OFFSET #{f.offset}
    </select>

    <select id="countPerformances" resultType="long">
        SELECT COUNT(*)
          FROM performance p
         WHERE 1 = 1
        <include refid="commonFilters"/>
        <if test="f.category != null and f.category != ''">AND p.category = #{f.category}</if>
        <if test="f.venue != null and f.venue != ''">AND p.venue = #{f.venue}</if>
    </select>

    <!-- category 필터는 무시(다른 카테고리를 골랐을 때의 건수를 보여줘야 하니까), month/venue 는 반영 -->
    <select id="selectCategoryCounts" resultType="com.portfolio.ticket.mapper.dto.FacetCountRow">
        SELECT p.category AS label, COUNT(*) AS count
          FROM performance p
         WHERE 1 = 1
        <include refid="commonFilters"/>
        <if test="f.venue != null and f.venue != ''">AND p.venue = #{f.venue}</if>
         GROUP BY p.category
         ORDER BY count DESC
    </select>

    <!--
        month 필터는 무시(다른 달을 골랐을 때의 건수를 보여줘야 하니까), 나머지는 반영.

        EXISTS 가 아니라 회차를 JOIN 해서 센다 — "몇 월에 회차가 있나" 를 세는 집계라
        회차 행 자체가 필요하다. 대신 한 공연이 같은 달에 회차를 여러 개 가지므로
        COUNT(DISTINCT p.id) 로 공연 단위로 접는다(COUNT(*) 면 회차 수가 세어진다).

        요일/시간대 조건도 이 JOIN 에 같이 건다. 안 걸면 "주말" 을 고른 상태에서 8월 옆
        건수가 <i>주말과 무관한</i> 8월 공연까지 세어, 8월을 눌렀을 때 실제로 나오는
        건수와 달라진다.
    -->
    <select id="selectMonthCounts" resultType="com.portfolio.ticket.mapper.dto.FacetCountRow">
        SELECT MONTH(ps.show_at) AS label, COUNT(DISTINCT p.id) AS count
          FROM performance p
          JOIN performance_schedule ps ON ps.performance_id = p.id
         WHERE 1 = 1
        <include refid="scheduleConditions"/>
        <include refid="nonScheduleFilters"/>
        <if test="f.category != null and f.category != ''">AND p.category = #{f.category}</if>
        <if test="f.venue != null and f.venue != ''">AND p.venue = #{f.venue}</if>
         GROUP BY MONTH(ps.show_at)
         ORDER BY label ASC
    </select>

    <!-- venue 필터는 무시, category/month 는 반영. 상위 N + "기타" 로 묶는 건 호출부 몫 -->
    <select id="selectVenueCounts" resultType="com.portfolio.ticket.mapper.dto.FacetCountRow">
        SELECT p.venue AS label, COUNT(*) AS count
          FROM performance p
         <!-- 공연장명이 없는 공연(문화정보 일부)은 고를 수 있는 필터 값이 아니다.
              빼지 않으면 label 이 null 인 옵션이 만들어져 목록 화면이 NPE 로 죽는다. -->
         WHERE p.venue IS NOT NULL AND p.venue &lt;&gt; ''
        <include refid="commonFilters"/>
        <if test="f.category != null and f.category != ''">AND p.category = #{f.category}</if>
         GROUP BY p.venue
         ORDER BY count DESC
    </select>

</mapper>
