# EC2 배포용 환경변수 예시.
#
# 이 파일을 .env 로 복사해서 값을 채운다. docker-compose 가 같은 디렉터리의 .env 를
# 자동으로 읽는다. .env 자체는 .gitignore 로 막혀 있다 — 절대 커밋하지 말 것.
#
#   cp .env.example .env && vi .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# 비워 두면 어떻게 되는지도 같이 적었다. 앱은 키가 없어도 기동은 되지만(외부 호출이
# 빈 결과를 반환하는 설계다) 해당 기능만 조용히 죽는다.

# --- DB (필수, 없으면 compose 가 기동을 거부한다) ---
DB_USER=ticket
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- 공연 데이터 수집 ---
# data.go.kr. 표준데이터·문화정보 두 소스가 쓴다.
PUBLICDATA_SERVICE_KEY=
# kopis.or.kr 에서 따로 발급. 없으면 공연 대부분을 차지하는 KOPIS 소스가 통째로 안 들어온다.
KOPIS_SERVICE_KEY=

# --- 결제 ---
# 없으면 결제 버튼이 동작하지 않는다. TOSS_MOCK 은 여기 두지 말 것 —
# prod 에서 켜지면 MockPaymentGuard 가 기동을 거부한다.
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# --- 소셜 로그인 (없으면 폼 로그인만 동작) ---
# 콘솔에 Callback URL 을 등록해야 한다: https://<도메인>/login/oauth2/code/{kakao|naver}
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- 공연 상세 부가 기능 ---
# 카카오톡 공유 버튼. KAKAO_CLIENT_ID(REST API 키)와 다른 "JavaScript 키"다.
# 없으면 버튼 자체가 안 뜬다.
KAKAO_JS_KEY=
# 공연장 위치 지도. Maps 콘솔에 배포 도메인을 등록해야 인증을 통과한다.
# 없으면 지도 없이 길찾기 링크만 나온다.
NAVER_MAP_CLIENT_ID=

# --- 비밀번호 재설정 메일 ---
# 없으면 재설정 링크 발송이 실패한다. Gmail 은 앱 비밀번호를 쓰고,
# MAIL_FROM_ADDRESS 는 보통 MAIL_USERNAME 과 같은 값으로 둔다.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
